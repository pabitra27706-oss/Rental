# Roam — configuration template. Copy to `.env` and adjust. Never commit real secrets.
#   cp .env.example .env

# --- Core ---
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=development-only-change-this-secret
PORT=5000
RENTAL_TIMEZONE=Asia/Kolkata

# --- Database ---
# Leave unset for the seeded SQLite demo DB (backend/instance/roam.db).
# DATABASE_URL=mysql+pymysql://rental_user:password@127.0.0.1:3306/vehicle_rental?charset=utf8mb4

# --- Demo data / sessions ---
# SEED_DEMO=1 creates the sample accounts and fleet when the database is empty.
SEED_DEMO=1
SESSION_COOKIE_SECURE=0
# Use 'None' only when the browser must send the session cookie from a third-party
# (cross-site) iframe, e.g. an embedded preview that is not proxied by this server.
SESSION_COOKIE_SAMESITE=Lax

# --- Payments ---
# mock (default, simulated) or razorpay_test. Live keys are rejected.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Password reset ---
# SHOW_RESET_LINK=1 prints the one-use reset link on the recovery page (demo only).
SHOW_RESET_LINK=1
PUBLIC_BASE_URL=http://localhost:5000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Uploads ---
# UPLOAD_DIR=/absolute/path/to/uploads

# --- Embedding ---
# CSP frame-ancestors allow-list for iframed deployments. Empty = '*' in
# development and 'self' in production.
# FRAME_ANCESTORS=https://your-preview-host.example
